use nix

# Load environment variables from .env file if it exists
if [ -f .env ]; then
  dotenv .env
fi

# Add terraform directory to PATH for convenience
export PATH=$PWD/terraform:$PATH

# rclone's config holds the Google Drive login, encrypted; its password lives in the keychain
export RCLONE_PASSWORD_COMMAND="security find-generic-password -s heartbeat-rclone-config -w"

# Cloudflare: wrangler only ever targets the Heartbeat Church account; the token comes from the keychain, never disk.
# One-time copy from Key Vault: see terraform/pulse-v2/README.md.
export CLOUDFLARE_ACCOUNT_ID=d26a8771162442a563371ea8097acc89
CLOUDFLARE_API_TOKEN=$(security find-generic-password -a "$USER" -s heartbeat-cloudflare-api-token -w 2>/dev/null) && export CLOUDFLARE_API_TOKEN
