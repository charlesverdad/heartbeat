// Pulse v2 production Worker, deployed from a prebuilt bundle by deploy.sh.
//
// Based on the bundle's wrangler.example.jsonc (pulse-v2 docs/deploy.md section 10), with only the production
// environment. deploy.sh diffs the binding names against each new bundle's example and refuses to deploy if they differ.
//
// * __D1_DATABASE_ID__ and __PUBLIC_ORIGIN__ are filled in by deploy.sh from terraform/pulse-v2 outputs.
// * Custom domains are attached by terraform/pulse-v2, not here, so there are no routes.
// * Secrets are never in this file: deploy.sh --secrets streams them from Azure Key Vault (secrets.sh).
//   ADMIN_EMAILS is one of them, so it is deliberately not a var here (keep_vars would not protect it).
{
	"name": "pulse",
	// keep_vars is top-level only (wrangler ignores it per environment).
	"keep_vars": true,
	"account_id": "d26a8771162442a563371ea8097acc89",
	"main": "worker/worker.js",
	"no_bundle": true,
	// pulse-v2 W18P: skip esbuild's __name() wrappers, which cost CPU on every request.
	"keep_names": false,
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "nodejs_als", "global_fetch_strictly_public"],
	"assets": { "directory": "assets", "binding": "ASSETS" },

	"env": {
		"production": {
			"name": "pulse",
			"workers_dev": false,
			"preview_urls": false,
			// pulse-v2 decision 020 §3 D: run next to the OC database. Revert = delete this line and redeploy.
			"placement": { "region": "aws:ap-southeast-2" },
			"observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
			"assets": { "directory": "assets", "binding": "ASSETS" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pulse",
					"database_id": "__D1_DATABASE_ID__",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "FILES", "bucket_name": "pulse-files" }],
			"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "__OAUTH_KV_ID__" }],
			"queues": {
				"producers": [{ "binding": "EMAIL_QUEUE", "queue": "pulse-email" }],
				"consumers": [
					{ "queue": "pulse-email", "max_retries": 0, "max_batch_size": 10, "max_batch_timeout": 5 }
				]
			},
			"send_email": [{ "name": "EMAIL" }],
			"ratelimits": [
				{ "name": "API_LIMITER", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } },
				{ "name": "AUTH_LIMITER", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } },
				{ "name": "INVITE_LIMITER", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
				{ "name": "CALLBACK_LIMITER", "namespace_id": "3004", "simple": { "limit": 120, "period": 60 } },
				{ "name": "OAUTH_REGISTER_LIMITER", "namespace_id": "3005", "simple": { "limit": 5, "period": 60 } }
			],
			"triggers": { "crons": ["*/5 * * * *"] },
			"vars": {
				"PUBLIC_ORIGIN": "__PUBLIC_ORIGIN__",
				"MCP_ALLOWED_ORIGINS": "",
				"D1_READ_MODE": "primary"
			},
			"secrets": { "required": ["HMAC_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] }
		}
	}
}
